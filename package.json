{
  "name": "oss-ui",
  "private": true,
  "description": "Open-source UI packages by Studio Nordwerk, built on the native platform first.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node --test \"packages/*/test/unit/*.test.ts\"",
    "size": "node scripts/size.mjs",
    "site": "node scripts/build.mjs && node scripts/site.mjs",
    "fixtures": "node scripts/fixtures.mjs",
    "lint:package": "node scripts/lint-package.mjs",
    "test:e2e": "playwright test",
    "test:shadcn": "node scripts/shadcn-smoke.mjs",
    "serve": "node scripts/serve.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm site && pnpm size && pnpm lint:package && pnpm fixtures && pnpm test:e2e"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@axe-core/playwright": "4.13.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@playwright/test": "1.61.1",
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "publint": "0.3.24",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.5.1"
}
