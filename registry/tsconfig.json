{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "@/lib/utils": ["./shims/utils.ts"],
      "@/components/ui/button": ["./shims/button.tsx"],
      "@/components/ui/badge": ["./shims/badge.tsx"],
      "@/components/ui/scroll-carousel": ["./ui/scroll-carousel.tsx"],
      "@nordwerk/scroll-carousel": ["../src/index.ts"],
      "@nordwerk/scroll-carousel/*": ["../src/*.ts"]
    }
  },
  "include": ["ui/**/*.tsx", "blocks/**/*.tsx", "shims/**/*"]
}
